const number=100;
const string="Hello World";
const boolean=true;
const nullValue=null;
let undefinedValue;

console.log("Number:", number);
console.log("String:", string);
console.log("Boolean:", boolean);
console.log("Null:", nullValue);
console.log("Undefined:", undefinedValue);

console.table({ number, string, boolean, nullValue, undefinedValue });

console.log("Type of number:", typeof number);
console.log("Type of string:", typeof string);
console.log("Type of boolean:", typeof boolean);
console.log("Type of nullValue:", typeof nullValue);
console.log("Type of undefinedValue:", typeof undefinedValue);

